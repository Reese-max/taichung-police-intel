{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "govintel-query-gateway",
  "main": "src/index.js",
  "compatibility_date": "2026-09-18",
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  "workers_dev": true,
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "RESEARCH_ENABLED": "false",
    "MINIMAX_BILLING_REVIEWED": "false",
    "PUBLIC_ORIGIN": "https://reese-max.github.io/taichung-police-intel",
    "ALLOWED_ORIGINS": "https://reese-max.github.io,http://localhost:3000"
  }
}
