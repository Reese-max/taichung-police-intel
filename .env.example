# Required by the online API, migration runner, and twice-daily collector.
DATABASE_URL=

# Set this only when intentionally rerunning the paid/live ASR pipeline.
GROQ_API_KEY=

# Optional change-summary model. Leave unset: the default provider is DISABLED.
# Only PUBLIC_DERIVED sources or synthetic fixtures are ever sent (see docs/govintel/change-summary.md).
GOVINTEL_SUMMARY_PROVIDER=
GOVINTEL_SUMMARY_MODEL=
ANTHROPIC_API_KEY=
